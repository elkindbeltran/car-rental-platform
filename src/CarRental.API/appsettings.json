{
  "AllowedHosts": "*",
  "Auth0": {
    "Authority": "https://replace-with-your-tenant.auth0.com/",
    "Audience": "https://api.car-rental.example.com",
    "NameClaimType": "sub",
    "RoleClaimType": "https://car-rental.example.com/roles"
  },
  "ConnectionStrings": {
    "CarRentalDatabase": "Server=(localdb)\\MSSQLLocalDB;Database=CarRental;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
